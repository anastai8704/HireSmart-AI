{
  "name": "hire-smart-ai-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest"
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-query": "^3.34.0",
    "react-hook-form": "^7.0.0",
    "zod": "^3.0.0",
    "tailwindcss": "^2.2.0",
    "shadcn/ui": "^1.0.0",
    "axios": "^0.21.1"
  },
  "devDependencies": {
    "vite": "^2.6.0",
    "typescript": "^4.4.0",
    "eslint": "^7.32.0",
    "vitest": "^0.0.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:react/recommended",
      "plugin:@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": 2020,
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "plugins": [
      "react",
      "@typescript-eslint"
    ],
    "rules": {
      "react/react-in-jsx-scope": "off"
    }
  },
  "browserslist": [
    ">0.25%",
    "not dead"
  ]
}