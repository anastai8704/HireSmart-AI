    "nodemailer": "^6.4.11",
    "zod": "^1.11.6"
  },
  "devDependencies": {
    "typescript": "^4.3.2",
    "ts-node": "^10.0.0",
    "ts-node-dev": "^1.1.8",
    "jest": "^27.0.6",
    "eslint": "^7.27.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.1",
    "prettier": "^2.3.2"
