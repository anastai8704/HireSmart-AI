NODE_ENV=development
PORT=5000
# Keep false in production; legacy /api routes exist only for migration/testing.
ENABLE_LEGACY_API=true
MONGO_URI=mongodb://127.0.0.1:27017/hiresmart_ai
JWT_SECRET=replace_with_a_long_random_secret
# Legacy API token lifetime; /api/v1 uses short access + rotating refresh sessions.
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_COOKIE_NAME=hiresmart_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGIN=http://localhost:5173
RECRUITER_INVITE_CODE=
EMAIL_FROM=no-reply@hiresmart.ai
CLIENT_URL=http://localhost:5173
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=86400000
PASSWORD_RESET_TOKEN_EXPIRES_IN=3600000
# Provider names other than deterministic use an OpenAI-compatible HTTPS API.
AI_PRIMARY_PROVIDER=deterministic
AI_FALLBACK_PROVIDER=deterministic
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
EMBEDDINGS_PROVIDER=deterministic
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
PROCESS_JOBS_INLINE=false
# Production must provide an internal scanner endpoint returning {"clean":true|false}.
MALWARE_SCANNER_URL=
MALWARE_SCAN_TIMEOUT_MS=15000
MATCH_WEIGHT_REQUIRED_SKILLS=0.35
MATCH_WEIGHT_PREFERRED_SKILLS=0.10
MATCH_WEIGHT_EXPERIENCE=0.20
MATCH_WEIGHT_EDUCATION=0.10
MATCH_WEIGHT_SEMANTIC=0.20
MATCH_WEIGHT_PREFERENCES=0.05
ADMIN_NAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
