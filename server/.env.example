NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hiresmart_ai
JWT_SECRET=replace_with_a_long_random_secret
# Legacy API token lifetime; /api/v1 uses short access + rotating refresh sessions.
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_COOKIE_NAME=hiresmart_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGIN=http://localhost:5173
RECRUITER_INVITE_CODE=
EMAIL_FROM=no-reply@hiresmart.ai
CLIENT_URL=http://localhost:5173
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=86400000
PASSWORD_RESET_TOKEN_EXPIRES_IN=3600000
# Provider names other than deterministic use an OpenAI-compatible HTTPS API.
AI_PRIMARY_PROVIDER=deterministic
AI_FALLBACK_PROVIDER=deterministic
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
EMBEDDINGS_PROVIDER=deterministic
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
PROCESS_JOBS_INLINE=false
# Production must provide an internal scanner endpoint returning {"clean":true|false}.
MALWARE_SCANNER_URL=
MALWARE_SCAN_TIMEOUT_MS=15000
MATCH_WEIGHT_REQUIRED_SKILLS=0.35
MATCH_WEIGHT_PREFERRED_SKILLS=0.10
MATCH_WEIGHT_EXPERIENCE=0.20
MATCH_WEIGHT_EDUCATION=0.10
MATCH_WEIGHT_SEMANTIC=0.20
MATCH_WEIGHT_PREFERENCES=0.05
ADMIN_NAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Payments (see docs/PAYMENTS.md). Default is disabled: checkout returns 503 and no subscription is created.
# disabled        no payments (default)
# simulation      local sandbox only, one-time orders; refused unless NODE_ENV is development or test
# razorpay_test   Razorpay TEST mode with recurring subscriptions (monthly, or yearly once a yearly price is set).
#                 Refused when NODE_ENV=production. Keys must start with rzp_test_.
# Live payments are not enabled in this release. Live keys (rzp_live_) are refused at startup.
PAYMENT_MODE=disabled
# Required (32+ characters) only when PAYMENT_MODE=simulation. Never reuse a production secret.
PAYMENT_SIMULATION_SECRET=
# Required only when PAYMENT_MODE=razorpay_test. Use the TEST key pair from the Razorpay dashboard (Test Mode).
# Store these in the environment or a secrets manager, never in the repository.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret for the webhook endpoint (POST /api/v1/payments/webhooks/razorpay). At least 16 characters.
# Set the same value on the webhook in the Razorpay dashboard (Test Mode). Subscribe to these events:
# subscription.authenticated, subscription.activated, subscription.charged, subscription.pending,
# subscription.halted, subscription.cancelled, subscription.completed, subscription.paused,
# subscription.resumed, subscription.updated, payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# Company verification (Phase 2). Optional. Without a registry URL every registry lookup reports
# "unavailable" and the case waits for manual verification. Must be an HTTPS endpoint that accepts
# POST JSON { registrationNumber, gstin, legalName, country }. No provider is bundled or assumed.
COMPANY_REGISTRY_URL=

# Demo seed only (npm run demo). Dev/test only; the seeder refuses NODE_ENV=production. Min 12 chars. Never commit a real value.
DEMO_PASSWORD=

# Google Calendar and Google Meet (Requirement 4). Full steps: docs/GOOGLE_CALENDAR_SETUP.md.
# All four are needed for automatic Meet links. Without them the app shows "setup required" (no fake link is made).
# Create the OAuth client in Google Cloud Console (Web application). Never commit these values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console exactly, for example:
# http://localhost:5000/api/v1/integrations/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
# 32 random bytes encoded as base64 or hex. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Demo accounts (development and test only; see docs/DEMO_ACCOUNTS.md). Never set these in production.
# DEMO_PASSWORD: at least 12 characters, used for every demo account. It is hashed; it is never printed or stored in code.
DEMO_PASSWORD=
# Exact name of the local development database that `npm run demo:reset` may erase. It must match the connected database.
DEMO_RESET_DATABASE=
# Optional. Defaults to tofu1180@gmail.com. Created on seed if missing; an existing account is never changed.
DEMO_ADMIN_EMAIL=
